#!/usr/bin/env bash
# Keeps subject lines readable. Deliberately permissive about the PREFIX,
# because a hook that rejects a third of the team's existing style is a hook
# people bypass: of the last 200 commits, 135 carry a recognised prefix and 65
# do not, and several of those 65 are perfectly clear ("Redesign coach Team
# Home onto the personal Home's layout").
#
# So the prefix is a WARNING and the noise is a hard failure. Flip STRICT_PREFIX
# to 1 once the team has settled on a convention and wants it enforced.
set -uo pipefail

STRICT_PREFIX=0        # 1 = reject a missing type prefix instead of warning
HARD_MAX=120           # a subject this long is a paragraph, not a summary
SOFT_MAX=72            # git's conventional limit; warn past it

msg_file=$1
subject=$(grep -vE '^\s*#' "$msg_file" | sed '/^\s*$/d' | head -1)

# A merge, revert, fixup or squash subject is generated by git. Leave it alone.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

fail=0
err()  { printf '\n\033[1;31mcommit-msg:\033[0m %s\n' "$1" >&2; fail=1; }
warn() { printf '\n\033[1;33mcommit-msg:\033[0m %s\n' "$1" >&2; }

[ -n "$subject" ] || err "empty commit subject."

len=${#subject}
[ "$len" -gt "$HARD_MAX" ] && err "subject is $len chars (hard limit $HARD_MAX). Move the detail into the body."
[ "$len" -gt "$SOFT_MAX" ] && [ "$len" -le "$HARD_MAX" ] && \
  warn "subject is $len chars; $SOFT_MAX is the conventional limit."

case "$subject" in
  *.) err "subject ends with a period — drop it. (0 of your last 200 commits had one.)" ;;
esac

grep -qE '^(<<<<<<<|>>>>>>>|=======)$' "$msg_file" && err "the message still contains merge-conflict markers."

TYPES='feat|fix|docs|refactor|test|chore|perf|style|build|ci|pipeline|review|task|pr-check'
if ! printf '%s' "$subject" | grep -qE "^(($TYPES)(\([a-z0-9._/-]+\))?|T[0-9]+[a-z]?): .+"; then
  m="no recognised prefix. Preferred: '<type>(<scope>): <subject>' or 'T<n>: <subject>'
    types: $(printf '%s' "$TYPES" | tr '|' ' ')"
  [ "$STRICT_PREFIX" -eq 1 ] && err "$m" || warn "$m"
fi

[ "$fail" -eq 0 ] || { printf '\ncommit aborted. Use --no-verify to override.\n' >&2; exit 1; }
exit 0
