# Copy to .env.local and fill in. Never commit real values — .gitignore covers
# .env* with an explicit exception for this file only.

# ---------------------------------------------------------------------------
# Supabase — required for the app to start
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this deployment. Also drives `metadataBase` and the Stripe
# checkout redirect, and now builds the vendor's WebhookUrl. Must be the
# deployed origin, not localhost, or the vendor cannot call back.
#
# SET THIS PER ENVIRONMENT IN VERCEL. One value shared by Production and
# Preview means a preview deployment hands the vendor the production origin —
# where the webhook route does not exist until this branch merges. The POST
# 404s, the results are lost, and nothing on either side looks wrong.
#
#   Production → https://app.advantage-analytics.com
#   Preview    → the preview deployment's own URL
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# LLM — optional. Without a key, /api/chat falls back to mock responses.
# ---------------------------------------------------------------------------

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Video analysis vendor (internally "splitstep", "Advantage Intelligence" in
# any user-visible string). Not needed until Phase 1 submission ships.
# ---------------------------------------------------------------------------

SPLITSTEP_API_KEY=

# Sent as the X-Api-Key header. The published docs show a placeholder
# (https://api.example.com/jobs) — get the real endpoint before submitting.
SPLITSTEP_API_URL=

# Shared secret guarding the webhook until the vendor documents a real signing
# scheme (TODO(splitstep-q4)). Sent as X-Webhook-Secret, X-Api-Key, or
# Authorization: Bearer — the route accepts any of the three.
#
# LEAVING THIS UNSET IS A DELIBERATE MODE, NOT AN OVERSIGHT: the webhook then
# accepts unsigned deliveries so the smoke test can run before the vendor has
# implemented anything on their side. Every such delivery is logged as unsigned
# and stored with signature_verified = false.
#
# While unset, the endpoint is an open write path against processing_jobs for
# anyone who finds the URL. Fine for a test with a throwaway video. Set it
# before any real athlete video goes through.
SPLITSTEP_WEBHOOK_SECRET=

# Fail closed on webhook deliveries carrying no recognisable signature header.
#
# Left OFF during the pilot on purpose. The vendor has no retry policy and a
# 30s timeout, so a delivery we refuse is gone for good — and the header the
# signature arrives in is not documented anywhere. Refusing on "no signature
# found" could therefore discard valid results because we looked in the wrong
# place. A signature that IS present and does not match is always refused,
# flag or no flag.
#
# Set to true the moment one real delivery has confirmed the header name (the
# route logs the full header set whenever it cannot find one), and before any
# real athlete video goes through.
SPLITSTEP_WEBHOOK_REQUIRE_SIGNATURE=

# ---------------------------------------------------------------------------
# Azure Blob Storage — source video
# ---------------------------------------------------------------------------
#
# The provider's API accepts a VideoUrl only on blob.core.windows.net; other
# hosts are documented as unsupported and they confirmed that is a hard block.
# So this is where match video lives, and it is what replaced Cloudflare R2.
#
# All three are required before a job can be submitted: minting a vendor URL
# throws without them, deliberately, rather than producing a dead link.
#
# Set these PER ENVIRONMENT in Vercel. A Preview deployment sharing Production's
# account is not a smaller problem than sharing an origin — it is test uploads
# landing in the container real athlete video lives in.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=advantage-videos

# The storage account also needs a CORS rule on the BLOB service before any
# browser upload will work, because the upload goes straight from the browser to
# Azure. Without it the failure is a bare network error with no CORS wording
# anywhere — allowed methods PUT/GET/HEAD/OPTIONS, allowed headers
# x-ms-blob-type, x-ms-blob-content-type, x-ms-version, content-type.

# ---------------------------------------------------------------------------
# Cloudflare R2 — RETIRED, pending removal
# ---------------------------------------------------------------------------
#
# Superseded by the Azure block above. Kept until the Azure path has carried one
# real job end to end; the Worker and both R2 edge functions go with them.

# Origin of the video-access Worker — see workers/video-access/README.md. The
# app appends /v/{token}. No longer read by anything: the vendor will not fetch
# from our host, which is what made the Worker pointless.
R2_PUBLIC_WORKER_URL=

# Bucket for original videos. Must match `bucket_name` in
# workers/video-access/wrangler.toml.
R2_BUCKET_VIDEOS=advantage-videos

# UNUSED. The spec put results JSON in R2; that was superseded — results now go
# to the Supabase Storage `match-results` bucket (docs/splitstep-handoff.md §2.1,
# migration 20260805005801). Kept only so anyone following the old spec finds
# this note instead of silently provisioning a bucket nothing writes to.
# R2_BUCKET_RESULTS=advantage-match-results

# S3-compatible credentials for the UPLOAD path — presigning browser→R2
# multipart PUTs, and writing results JSON. The vendor read path does not use
# these; it goes through the Worker's R2 binding instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
