# Copy to .env.local and fill in. Never commit real values — .gitignore covers
# .env* with an explicit exception for this file only.

# ---------------------------------------------------------------------------
# Supabase — required for the app to start
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this app, used to build the vendor's WebhookUrl. Must be the
# deployed origin, not localhost, or the vendor cannot call back.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# LLM — optional. Without a key, /api/chat falls back to mock responses.
# ---------------------------------------------------------------------------

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Video analysis vendor (internally "splitstep", "Advantage Intelligence" in
# any user-visible string). Not needed until Phase 1 submission ships.
# ---------------------------------------------------------------------------

SPLITSTEP_API_KEY=

# Sent as the X-Api-Key header. The published docs show a placeholder
# (https://api.example.com/jobs) — get the real endpoint before submitting.
SPLITSTEP_API_URL=

# Shared secret guarding the webhook until the vendor documents a real signing
# scheme (TODO(splitstep-q4)). Do not ship the webhook without it.
SPLITSTEP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2
# ---------------------------------------------------------------------------

# Origin of the video-access Worker — see workers/video-access/README.md. The
# app appends /v/{token}. Required before any job can be submitted: minting a
# vendor URL throws without it, deliberately, rather than producing a dead link.
R2_PUBLIC_WORKER_URL=

# Separate buckets for originals and results (spec §3.2 decision 2). The videos
# bucket name must match `bucket_name` in workers/video-access/wrangler.toml.
R2_BUCKET_VIDEOS=advantage-match-videos
R2_BUCKET_RESULTS=advantage-match-results

# S3-compatible credentials for the UPLOAD path — presigning browser→R2
# multipart PUTs, and writing results JSON. The vendor read path does not use
# these; it goes through the Worker's R2 binding instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
