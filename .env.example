# Copy to .env.local and fill in. Never commit real values — .gitignore covers
# .env* with an explicit exception for this file only.

# ---------------------------------------------------------------------------
# PostHog — analytics, error tracking, logs and AI observability
# ---------------------------------------------------------------------------

# Optional. Unset, the app boots and runs with PostHog off — no analytics,
# replay, error tracking, logs or AI observability, and no errors either.
#
# One pair for browser AND server: instrumentation.ts (logs, server errors) and
# the LLM adapter read these too. The project token (phc_…) is public by design
# — it ships in the browser bundle — so Vercel's "NEXT_PUBLIC_ … TOKEN" warning
# does not apply. Never put a personal API key (phx_…) here.
#
# The generate-insights edge function cannot see Vercel's env: set the same
# values there as Supabase secrets POSTHOG_PROJECT_TOKEN and POSTHOG_HOST.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Supabase — required for the app to start
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this deployment. Also drives `metadataBase` and the Stripe
# checkout redirect, and now builds the vendor's WebhookUrl. Must be the
# deployed origin, not localhost, or the vendor cannot call back.
#
# SET THIS PER ENVIRONMENT IN VERCEL. One value shared by Production and
# Preview means a preview deployment hands the vendor the production origin —
# where the webhook route does not exist until this branch merges. The POST
# 404s, the results are lost, and nothing on either side looks wrong.
#
#   Production → https://app.advantage-analytics.com
#   Preview    → the preview deployment's own URL
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# LLM — optional. Without a key, /api/chat falls back to mock responses.
# ---------------------------------------------------------------------------

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Video analysis vendor (internally "splitstep", "Advantage Intelligence" in
# any user-visible string). Not needed until Phase 1 submission ships.
# ---------------------------------------------------------------------------

SPLITSTEP_API_KEY=

# Sent as the X-Api-Key header. The published docs show a placeholder
# (https://api.example.com/jobs) — get the real endpoint before submitting.
SPLITSTEP_API_URL=

# Shared secret guarding the webhook until the vendor documents a real signing
# scheme (TODO(splitstep-q4)). Sent as X-Webhook-Secret, X-Api-Key, or
# Authorization: Bearer — the route accepts any of the three.
#
# LEAVING THIS UNSET IS A DELIBERATE MODE, NOT AN OVERSIGHT: the webhook then
# accepts unsigned deliveries so the smoke test can run before the vendor has
# implemented anything on their side. Every such delivery is logged as unsigned
# and stored with signature_verified = false.
#
# While unset, the endpoint is an open write path against processing_jobs for
# anyone who finds the URL. Fine for a test with a throwaway video. Set it
# before any real athlete video goes through.
SPLITSTEP_WEBHOOK_SECRET=

# Fail closed on webhook deliveries carrying no recognisable signature header.
#
# Left OFF during the pilot on purpose. The vendor has no retry policy and a
# 30s timeout, so a delivery we refuse is gone for good — and the header the
# signature arrives in is not documented anywhere. Refusing on "no signature
# found" could therefore discard valid results because we looked in the wrong
# place. A signature that IS present and does not match is always refused,
# flag or no flag.
#
# Set to true the moment one real delivery has confirmed the header name (the
# route logs the full header set whenever it cannot find one), and before any
# real athlete video goes through.
SPLITSTEP_WEBHOOK_REQUIRE_SIGNATURE=

# ---------------------------------------------------------------------------
# Transactional email — Resend
# ---------------------------------------------------------------------------
#
# Product email only: program invites, and the analysis notifications that
# follow. Auth email (confirm your address, reset your password) is sent by
# Supabase from supabase/email-templates/ and does NOT come through here.
#
# Sends from team@advantage-analytics.com. The domain is already verified for
# sending in Resend, so this key is the only thing needed.
#
# LEAVING THIS UNSET IS A DELIBERATE MODE: sendEmail() prints the message to
# the server console instead of sending it, so the whole invite flow stays
# walkable locally without a credential. Note that the printed text contains a
# WORKING invite token — server-side only, but it lands wherever your logs do.
#
# A deployment without this key silently invites nobody. Set it in Vercel for
# every environment that real people will use.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Vercel Cron
# ---------------------------------------------------------------------------
#
# Shared secret for every scheduled route, sent by Vercel Cron as
# `Authorization: Bearer <secret>`. Any long random string; generate one with
# `openssl rand -hex 32`. It is a credential, so it is never written here —
# set it in Vercel, for every environment whose database and storage you mind.
#
# ONE consumer today, scheduled in vercel.json:
#
#   /api/cron/cleanup-match-videos   daily at 05:00 UTC. Deletes the storage
#                                    objects behind attachment rows the
#                                    database has finished with — abandoned
#                                    upload attempts (idle 24h), orphans and
#                                    replaced video. Paired with the daily
#                                    schedule, an abandoned attempt is normally
#                                    collected 24-48 hours after its last
#                                    activity.
#
# (/api/cron/reclaim-videos, which deleted source videos once the vendor's
# trimmed copy landed, was retired in September 2026: the source is now cut to
# the selected window before upload and is the video we keep.)
#
# Leaving this unset FAILS CLOSED — every scheduled route refuses every call,
# including Vercel's own, rather than running unauthenticated. Locally that is
# usually what you want. On a deployment it means nothing is ever collected,
# so storage grows without bound; the refusal is logged by name at each call.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Azure Blob Storage — source video
# ---------------------------------------------------------------------------
#
# The provider's API accepts a VideoUrl only on blob.core.windows.net; other
# hosts are documented as unsupported and they confirmed that is a hard block.
# So this is where match video lives, and it is what replaced Cloudflare R2.
#
# All three are required before a job can be submitted: minting a vendor URL
# throws without them, deliberately, rather than producing a dead link.
#
# Set these PER ENVIRONMENT in Vercel. A Preview deployment sharing Production's
# account is not a smaller problem than sharing an origin — it is test uploads
# landing in the container real athlete video lives in.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=advantage-videos

# The storage account also needs a CORS rule on the BLOB service before any
# browser upload will work, because the upload goes straight from the browser to
# Azure. Without it the failure is a bare network error with no CORS wording
# anywhere — allowed methods PUT/GET/HEAD/OPTIONS, allowed headers
# x-ms-blob-type, x-ms-blob-content-type, x-ms-version, content-type.

# ---------------------------------------------------------------------------
# Admin route smoke test — tests/admin-routes.spec.ts. Optional; both required
# together to run that spec, unset everywhere else (CI included).
# ---------------------------------------------------------------------------
#
# Origin of a RUNNING server to hit over real HTTP (e.g. http://localhost:3500
# from `npm run build && npm run start -- -p 3500`). Not `npm run dev` — this
# branch's dev server is broken by a separate, already-logged Tailwind
# content-scanner bug.
ADMIN_SMOKE_BASE_URL=

# Explicit second opt-in, checked literally against "yes". The spec creates
# and deletes real throwaway Supabase auth users and a real throwaway program
# against whatever project ADMIN_SMOKE_BASE_URL's own server is wired to
# (via that server's .env.local) — having a base URL set is not by itself
# proof someone wants that to happen, so both must be set on purpose.
ADMIN_SMOKE_CONFIRM=

# ---------------------------------------------------------------------------
# Live-DB test opt-in — never set this in a gate or loop
# ---------------------------------------------------------------------------
#
# Live-DB specs (tests/fixtures/live-db.ts) refuse to run write specs against
# the production Supabase project (pouxujkhtbvkdwbzfvka) unless this is "1".
# A 2026-09-23 incident had parallel gate runs from several worktrees create
# and delete tens of thousands of auth users on production, saturating it
# until sign-in broke for real users. Leave this unset.
LIVE_DB_ALLOW_PROD=
