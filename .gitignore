# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# workers/ are separate deployments with their own dependency trees; the
# root-anchored rule above does not reach them.
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values.
!.env.example

# venv files
.venv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
#
# Shared team config is tracked — the hooks, the review agents, and the three
# skills written for this repo. Personal state is not: settings.local.json
# holds one person's permission allowlist, launch.json points at their own
# worktree paths, and worktrees/ is a working directory.
#
# .claude/skills/ is mostly THIRD-PARTY skills installed from the committed
# skills-lock.json (pbakaus/impeccable). Those are reinstallable dependencies,
# so only the project-authored three are tracked here. Add a new one to this
# list when you write it — the default is ignored.
.claude/*
!.claude/settings.json
!.claude/pipeline/
!.claude/agents/
!.claude/hooks/
!.claude/skills/
!.claude/tasks/
.claude/skills/*
!.claude/skills/create-migration/
!.claude/skills/pr-check/
!.claude/skills/trace-route/
!.claude/skills/task-next/
!.claude/skills/task-add/
!.claude/skills/feature-new/
!.claude/skills/feature-next/
.mcp.json

# Agent scratch: SDD ledgers, review packages, task briefs and reports. Never
# committed — but /task-next commits with `git add -A`, so an un-ignored
# .superpowers/ would ride into a task's commit.
.superpowers/

# lock files
package-lock.json
yarn.lock
pnpm-lock.yaml

# ide/editor
.vscode/
.idea/
*.swp
*.swo
*~

# playwright
.playwright-mcp/
/test-results/
/playwright-report/

# wrangler local state — per-machine build cache and a simulated local R2,
# regenerated on every `wrangler deploy`. Note the simulated bucket is why
# `wrangler r2 object get` reports "key does not exist" for objects that are
# really there: it reads local unless you pass --remote.
workers/*/.wrangler/

# agents
.agents

# design references
figma/design-refs/

# supabase cli
#
# `supabase/.temp/` is the CLI's local link state — project ref, pooler URL,
# and the service versions it saw last. Any `--linked` command writes it,
# including ones a gate subagent runs, so it turns up mid-run in a tree that
# has to be clean before a task commits. Regenerated on demand.
supabase/.temp/

# codex
#
# `AGENTS.md` and `.codex/` are the Codex mirror of this repo's Claude setup —
# the same repo guidance and the same three reviewer subagents, in Codex's own
# file conventions. A Codex session writes them into whatever worktree it runs
# in, so they turn up mid-run in a tree that has to be clean before a task
# commits, and `/task-next`'s `git add -A` would otherwise sweep them into an
# unrelated task's commit. Ignored rather than tracked: use `git add -f` if a
# version of either is ever meant to be shared.
AGENTS.md
.codex/

# analysis output
#
# `analysis/data/*.csv` is derived, not authored: `scripts/splitstep_json_to_csv.py`
# reproduces all three byte-for-byte from `tests/fixtures/splitstep/*.json`, both
# of which ARE committed, using nothing outside the Python standard library.
#
#   python3 scripts/splitstep_json_to_csv.py tests/fixtures/splitstep/*.json -o analysis/data
#
# That is ~1.1 MB of regenerable stroke data that would otherwise sit in a public
# repository's history forever. The notebook documents the same command in its
# first cell, so a fresh clone is one line away from running it.
analysis/data/
