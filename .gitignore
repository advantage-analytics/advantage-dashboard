# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# workers/ are separate deployments with their own dependency trees; the
# root-anchored rule above does not reach them.
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values.
!.env.example

# venv files
.venv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/
.mcp.json

# lock files
package-lock.json
yarn.lock
pnpm-lock.yaml

# ide/editor
.vscode/
.idea/
*.swp
*.swo
*~

# playwright
.playwright-mcp/
/test-results/
/playwright-report/

# wrangler local state — per-machine build cache and a simulated local R2,
# regenerated on every `wrangler deploy`. Note the simulated bucket is why
# `wrangler r2 object get` reports "key does not exist" for objects that are
# really there: it reads local unless you pass --remote.
workers/*/.wrangler/

# agents
.agents

# design references
figma/design-refs/
